<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kuicao.gofer</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/kuicao/Applications/Gofer/gofer</string>
    <string>serve</string>
    <string>--bind</string>
    <string>127.0.0.1:8790</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kuicao/Applications/Gofer</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/kuicao/.local/bin:/usr/local/opt/node/bin:/opt/homebrew/opt/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>GOFER_DB</key>
    <string>/Users/kuicao/.local/state/gofer/gofer.db</string>
    <!-- Release binaries embed scripts/ and web/. Do not set GOFER_SCRIPTS_DIR
         or GOFER_WEB_DIR here unless you intentionally override them. -->
    <!-- 留空 = 不校验 token；设置后所有 /v1 请求需带 X-Gofer-Token。
         面板里轮转 token 后，数据库值优先于这里；可在 Settings 回退。 -->
    <key>GOFER_TOKEN</key>
    <string></string>
    <!-- 可选：面板管理员密码重置。留空 = 使用面板内 /setup 设置的密码。
         设置后重启会写回数据库并轮换会话；之后可移除。 -->
    <key>GOFER_ADMIN_PASSWORD</key>
    <string></string>
    <!-- 可选：面板里展示的对外地址（例如 Tailscale 地址）。 -->
    <key>GOFER_PUBLIC_URL</key>
    <string></string>
    <!-- 反向代理终止 TLS 时设为 true，给会话 cookie 加 Secure。 -->
    <key>GOFER_COOKIE_SECURE</key>
    <string>false</string>
    <!-- 只影响微信/小红书通知；锁票始终真锁 -->
    <key>GOFER_DRY_RUN</key>
    <string>false</string>
    <key>GOFER_LOCK_HEADLESS</key>
    <string>true</string>
    <key>GOFER_RETENTION_DAYS</key>
    <string>30</string>
    <!-- 面板更新：launchd 模式退出后由 KeepAlive 拉起新二进制 -->
    <key>GOFER_SUPERVISED</key>
    <string>launchd</string>
    <!-- iGlance / Services：停止时 bootout，启动时 bootstrap 这个 plist。 -->
    <key>GOFER_LAUNCHD_LABEL</key>
    <string>com.kuicao.gofer</string>
    <key>GOFER_LAUNCHD_PLIST</key>
    <string>/Users/kuicao/Library/LaunchAgents/com.kuicao.gofer.plist</string>
    <!-- 可选：显式覆盖返回给 iGlance 的启动命令；留空=自动识别。 -->
    <key>GOFER_START_COMMAND</key>
    <string></string>
    <!-- 可选：GitHub 只读 token，避免 API 限流 -->
    <key>GOFER_UPDATE_TOKEN</key>
    <string></string>
    <key>MAOYAN_BOOKER_DIR</key>
    <string>/Users/kuicao/Applications/maoyan-booker</string>
    <!-- 锁票演示：随机影院所在城市（10=上海）和超时时间。 -->
    <key>GOFER_DEMO_CITY_ID</key>
    <string>10</string>
    <key>GOFER_DEMO_CINEMA_ID</key>
    <string></string>
    <key>GOFER_DEMO_MOVIE_ID</key>
    <string></string>
    <key>GOFER_DEMO_TIMEOUT_SECS</key>
    <string>600</string>
    <!-- 可选：指定演示脚本使用的 Python（默认 maoyan-booker/.venv 或 uv）。 -->
    <key>GOFER_DEMO_PYTHON</key>
    <string></string>
    <!-- 可选：小红书 session 过期时把二维码发到 Discord -->
    <key>XHS_WEBHOOK</key>
    <string></string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/kuicao/Library/Logs/gofer.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kuicao/Library/Logs/gofer.log</string>
</dict>
</plist>
